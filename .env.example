# Public values safe for the browser. Obtain them in Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional canonical URL for redirects and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local DEV quick access. Keep passwords only in .env.local; never commit real secrets.
ENABLE_TEST_LOGIN=false
TEST_ADMIN_EMAIL=admin@test.ur.local
TEST_ADMIN_PASSWORD=
TEST_ATHLETE_EMAIL=athlete@test.ur.local
TEST_ATHLETE_PASSWORD=
